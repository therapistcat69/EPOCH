# --- Backend only (never expose to the browser) ---
YOUTUBE_API_KEY=
DATABASE_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/youtube/callback

GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Leave blank to use the built-in default (llama-3.3-70b-versatile); set to any Groq chat model id to override.
GROQ_CHAT_MODEL=

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Long random string (also encrypts stored OAuth tokens). Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Frontend-safe (bundled into the browser) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ML ops: required header X-Admin-Token for POST /api/ml/retrain and /promote (when empty only loopback clients are allowed)
ADMIN_TOKEN=
RETRAIN_AFTER_REAL_LABELS=20
DRIFT_MIN_SAMPLES=10
