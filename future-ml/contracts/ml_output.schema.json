{
  "$defs": {
    "RiskSegment": {
      "properties": {
        "start_seconds": {
          "title": "Start Seconds",
          "type": "number"
        },
        "end_seconds": {
          "title": "End Seconds",
          "type": "number"
        },
        "risk": {
          "title": "Risk",
          "type": "number"
        },
        "reason_features": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Features",
          "type": "array"
        }
