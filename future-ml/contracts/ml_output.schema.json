    "video_id": {
      "title": "Video Id",
      "type": "string"
    },
    "model_name": {
      "title": "Model Name",
      "type": "string"
    },
    "model_version": {
      "title": "Model Version",
      "type": "string"
    },
    "retention_curve": {
      "default": [],
      "items": {
        "type": "number"
      },
      "title": "Retention Curve",
      "type": "array"
    },
