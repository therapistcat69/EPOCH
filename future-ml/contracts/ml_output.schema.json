        "$ref": "#/$defs/RiskSegment"
      },
      "title": "Risk Segments",
      "type": "array"
    },
    "confidence": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    }
  },
  "required": [
    "video_id",
    "model_name",
    "model_version"
  ],
  "title": "MLOutput",
  "type": "object"
